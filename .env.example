# ── Публичные настройки сайта (доступны в клиенте) ────────────────────
# NUXT_PUBLIC_SITE_URL=https://example.com
# NUXT_PUBLIC_CONTACT_TELEGRAM=@your_username
# NUXT_PUBLIC_CONTACT_MAX=https://max.ru/u/...
# NUXT_PUBLIC_CONTACT_PHONE=+7 900 000-00-00
# NUXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# NUXT_PUBLIC_COMPANY_NAME=Circle Lab

# ── Секреты для отправки заявок (см. server/api/order.post.ts) ─────────
# Реальные значения — в .env.development (dev) и .env.production (build)
# NUXT_SMTP_HOST=smtp.mail.ru
# NUXT_SMTP_PORT=465
# NUXT_SMTP_USER=you@example.com
# NUXT_SMTP_PASS=your_smtp_password
# NUXT_ORDER_EMAIL=you@example.com
# NUXT_TELEGRAM_BOT_TOKEN=123456:AAxxxxxx
# NUXT_TELEGRAM_CHAT_ID=-1001234567890
